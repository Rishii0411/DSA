2026-09-28|Range GCD Queries with Point Updates

Question
- Given `arr[]` and `queries[][]`:
- Type 1: `[0, l, r]` asks for `GCD(arr[l], ..., arr[r])`.
- Type 2: `[1, index, value]` changes `arr[index]` to `value`.
- Return the answers to all Type 1 queries in their original order.

Approach
1. Build a Segment Tree where each node stores the GCD of its corresponding range.

2. For a leaf node:
- Store the value of the corresponding array element.

3. For an internal node:
- If its children store `leftGCD` and `rightGCD`, store:
  `gcd(leftGCD, rightGCD)`

4. For a Type 1 query:
- Recursively combine the GCDs of the segments that overlap `[l, r]`.
- GCD has the useful property:
  `gcd(a, gcd(b, c)) = gcd(a, b, c)`

5. For a Type 2 query:
- Update the corresponding leaf.
- Recalculate all nodes on the path back to the root.

6. This gives `O(log n)` time for both range queries and point updates.

Solution
#include <bits/stdc++.h>
using namespace std;

class Solution {
    vector<int> seg;
    int n;

    void build(int node, int l, int r, vector<int>& arr) {
        if (l == r) {
            seg[node] = arr[l];
            return;
        }

        int mid = (l + r) / 2;

        build(node * 2, l, mid, arr);
        build(node * 2 + 1, mid + 1, r, arr);

        seg[node] = gcd(seg[node * 2], seg[node * 2 + 1]);
    }

    void update(int node, int l, int r, int index, int value) {
        if (l == r) {
            seg[node] = value;
            return;
        }

        int mid = (l + r) / 2;

        if (index <= mid) {
            update(node * 2, l, mid, index, value);
        } else {
            update(node * 2 + 1, mid + 1, r, index, value);
        }

        seg[node] = gcd(seg[node * 2], seg[node * 2 + 1]);
    }

    int query(int node, int l, int r, int ql, int qr) {
        if (qr < l || r < ql)
            return 0;

        if (ql <= l && r <= qr)
            return seg[node];

        int mid = (l + r) / 2;

        int leftGCD = query(node * 2, l, mid, ql, qr);
        int rightGCD = query(node * 2 + 1, mid + 1, r, ql, qr);

        return gcd(leftGCD, rightGCD);
    }

public:
    vector<int> rangeGCD(vector<int>& arr,
                         vector<vector<int>>& queries) {
        n = arr.size();

        seg.assign(4 * n, 0);

        build(1, 0, n - 1, arr);

        vector<int> result;

        for (auto& q : queries) {
            if (q[0] == 0) {
                // Type 1: GCD query [l, r]
                int l = q[1];
                int r = q[2];

                result.push_back(query(1, 0, n - 1, l, r));
            } else {
                // Type 2: point update [index, value]
                int index = q[1];
                int value = q[2];

                arr[index] = value;
                update(1, 0, n - 1, index, value);
            }
        }

        return result;
    }
};
```

Example
- `arr = [2, 6, 4, 8]`

- Query `[0, 0, 2]`:
  `gcd(2, 6, 4) = 2`

- Query `[1, 1, 3]`:
  Change `arr[1]` from `6` to `3`.

- Array becomes:
  `[2, 3, 4, 8]`

- Query `[0, 0, 2]`:
  `gcd(2, 3, 4) = 1`

- Therefore, the Type 1 answers are:
  `[2, 1]`

- Time Complexity:
  - Building the Segment Tree: O(n)
  - Each GCD query: O(log n)
  - Each point update: O(log n)
  - Overall: O(n + q log n)

- Space Complexity: O(n)
